# ═══════════════════════════════════════════════════════════════
# DOCKER IGNORE FILE
# ═══════════════════════════════════════════════════════════════
#
# Excludes files and directories from Docker build context
# This speeds up builds and reduces image size
#
# ═══════════════════════════════════════════════════════════════

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
.next
out
build
dist

# Database files (will be created in container)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment files (use env_file in docker-compose)
.env
.env.local
.env*.local
.env.development
.env.production

# Git
.git
.gitignore
.gitattributes

# GitHub
.github

# IDE
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Testing
coverage
.nyc_output
*.test.ts
*.spec.ts
__tests__

# Documentation (not needed in runtime)
docs/
*.md
!README.md

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
tmp
temp
*.tmp

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude

# Vercel
.vercel

# Scripts (not needed in container)
scripts/cleanup-report.sh
scripts/cleanup-report.ps1

# Setup scripts (not needed in container)
setup.sh
setup.ps1

# License instructions (not needed in container)
LICENSE-INSTRUCTIONS.md
CODIGO-FUENTE-ANALISIS.md
CLEANUP-REPORT.md
