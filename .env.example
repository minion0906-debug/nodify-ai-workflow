# ═══════════════════════════════════════════════════════════════
# NODIFY ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
#
# This file contains all environment variables required to run Nodify.
# Copy this file to .env.local and fill in your actual values.
#
# IMPORTANT: Never commit .env.local to version control!
#
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# APPLICATION SETTINGS
# ───────────────────────────────────────────────────────────────

# Application version (optional - defaults to package.json version)
# APP_VERSION=1.0.0

# Node environment (development, production, test)
# NODE_ENV=production

# Application port (default: 9003)
# PORT=9003

# Application URL (used for webhooks, emails, etc.)
# NEXT_PUBLIC_APP_URL=https://your-domain.com


# ───────────────────────────────────────────────────────────────
# WEBHOOKS & SECURITY
# ───────────────────────────────────────────────────────────────

# Secret token for webhook authentication
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_TOKEN=your_random_secret_here_replace_this

# Secret for cron job authentication
# Generate with: openssl rand -base64 32
CRON_SECRET=another_random_secret_here_replace_this


# ───────────────────────────────────────────────────────────────
# FIREBASE CLIENT CONFIGURATION
# ───────────────────────────────────────────────────────────────
#
# Get these values from:
# Firebase Console → Project Settings → General → Your apps → Web app
#

# Firebase API Key (public - safe to expose in client)
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...

# Firebase Auth Domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789

# Firebase App ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Firebase Database URL (optional - only if using Realtime Database)
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Firebase Measurement ID (optional - for Google Analytics)
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX


# ───────────────────────────────────────────────────────────────
# FIREBASE ADMIN (SERVER-SIDE)
# ───────────────────────────────────────────────────────────────
#
# For server-side Firebase operations. Choose ONE of these methods:
#
# METHOD 1 (Recommended): Service Account JSON in Base64
# Get from: Firebase Console → Project Settings → Service Accounts
#           → Generate New Private Key → Download JSON
# Convert to base64:
#   Linux/Mac: cat serviceAccountKey.json | base64 -w 0
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
#

FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2Vydmlj...

# METHOD 2 (Alternative): Individual fields from service account JSON
# Uncomment if not using BASE64 above
#
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"

# Firebase Storage Bucket (server-side)
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com


# ───────────────────────────────────────────────────────────────
# AI / GEMINI CONFIGURATION
# ───────────────────────────────────────────────────────────────
#
# Get API key from: https://makersuite.google.com/app/apikey
#

# Google Gemini API Key (required for AI features)
GEMINI_API_KEY=AIza...

# Gemini Model (optional - default: gemini-2.0-flash-exp)
# GEMINI_MODEL=gemini-2.0-flash-exp


# ───────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION (Optional)
# ───────────────────────────────────────────────────────────────
#
# Choose ONE email provider:
#

# OPTION 1: Resend (Recommended - https://resend.com)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@your-domain.com
# RESEND_FROM_NAME=Nodify

# OPTION 2: AWS SES
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY_ID=AKIA...
# AWS_SES_SECRET_ACCESS_KEY=...
# AWS_SES_FROM_EMAIL=noreply@your-domain.com

# OPTION 3: SendGrid
# SENDGRID_API_KEY=SG...
# SENDGRID_FROM_EMAIL=noreply@your-domain.com

# OPTION 4: SMTP (Generic - works with Gmail, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
# SMTP_FROM_EMAIL=noreply@your-domain.com
# SMTP_FROM_NAME=Nodify


# ───────────────────────────────────────────────────────────────
# PAYMENT PROCESSING (Optional)
# ───────────────────────────────────────────────────────────────

# Stripe Configuration
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_... (or sk_live_... for production)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_... (or pk_live_...)
# STRIPE_WEBHOOK_SECRET=whsec_... (from Stripe webhook settings)

# PayPal Configuration
# Get from: https://developer.paypal.com/dashboard/applications
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_MODE=sandbox (or live for production)


# ───────────────────────────────────────────────────────────────
# ERROR MONITORING (Optional but Recommended)
# ───────────────────────────────────────────────────────────────

# Sentry DSN for error tracking
# Get from: https://sentry.io → Create Project → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=... (for source maps upload)
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project


# ───────────────────────────────────────────────────────────────
# ANALYTICS (Optional)
# ───────────────────────────────────────────────────────────────

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel
# NEXT_PUBLIC_MIXPANEL_TOKEN=...

# Amplitude
# NEXT_PUBLIC_AMPLITUDE_API_KEY=...

# PostHog
# NEXT_PUBLIC_POSTHOG_KEY=...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ───────────────────────────────────────────────────────────────
# STORAGE & CDN (Optional)
# ───────────────────────────────────────────────────────────────

# Cloudflare R2 (S3-compatible storage)
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET_NAME=...

# AWS S3
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_ACCESS_KEY_ID=AKIA...
# AWS_S3_SECRET_ACCESS_KEY=...

# Cloudinary (for image optimization)
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...


# ───────────────────────────────────────────────────────────────
# RATE LIMITING (Optional - Production Recommended)
# ───────────────────────────────────────────────────────────────

# Redis connection for rate limiting (optional but recommended)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Upstash Redis (Serverless option)
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...


# ───────────────────────────────────────────────────────────────
# FEATURE FLAGS (Optional)
# ───────────────────────────────────────────────────────────────
#
# Enable/disable specific features
#

# Enable community forum
# NEXT_PUBLIC_ENABLE_COMMUNITY=true

# Enable AI nodes
# NEXT_PUBLIC_ENABLE_AI=true

# Enable custom node creation (Node Labs)
# NEXT_PUBLIC_ENABLE_NODE_LABS=true

# Enable admin panel
# NEXT_PUBLIC_ENABLE_ADMIN=true

# Enable social media integrations
# NEXT_PUBLIC_ENABLE_SOCIAL_MEDIA=true

# Enable billing/subscriptions
# NEXT_PUBLIC_ENABLE_BILLING=true


# ───────────────────────────────────────────────────────────────
# DEVELOPMENT & DEBUGGING
# ───────────────────────────────────────────────────────────────

# Enable verbose logging
# DEBUG=true

# Enable source maps in production
# NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false

# Analyze bundle size
# ANALYZE=false


# ───────────────────────────────────────────────────────────────
# SUBSCRIPTION LIMITS (Optional - Customize per deployment)
# ───────────────────────────────────────────────────────────────

# Free Plan Limits
# FREE_MAX_WORKFLOWS=3
# FREE_MAX_EXECUTIONS_PER_MONTH=100
# FREE_MAX_NODES_PER_WORKFLOW=10

# Pro Plan Limits
# PRO_MAX_WORKFLOWS=50
# PRO_MAX_EXECUTIONS_PER_MONTH=10000
# PRO_MAX_NODES_PER_WORKFLOW=100

# Enterprise Plan Limits
# ENTERPRISE_MAX_WORKFLOWS=999999
# ENTERPRISE_MAX_EXECUTIONS_PER_MONTH=999999
# ENTERPRISE_MAX_NODES_PER_WORKFLOW=999999


# ═══════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════
#
# NEXT STEPS:
# 1. Copy this file to .env.local
# 2. Fill in at minimum: Firebase config + Gemini API key
# 3. Never commit .env.local to git (it's in .gitignore)
# 4. Run: npm run dev
#
# For production deployment, see DEPLOYMENT.md
#
# ═══════════════════════════════════════════════════════════════
